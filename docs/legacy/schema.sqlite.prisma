generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
}
model User {
  id String @id @default(uuid())
  name String
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  categories Category[]
  transactions Transaction[]
}
model Category {
  id String @id @default(uuid())
  name String
  description String @default("")
  color String
  icon String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt DateTime @default(now())
  @@unique([userId, name])
  @@index([userId])
}
model Transaction {
  id String @id @default(uuid())
  description String
  amount Int
  type String
  date String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([userId, date])
  @@index([categoryId])
}
