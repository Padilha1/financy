JWT_SECRET=
# Local PostgreSQL from docker compose up -d db. On Neon, use the pooled URL.
DATABASE_URL="postgresql://financy:financy_local@127.0.0.1:5433/financy?schema=public"
# On Neon, paste the direct (non-pooler) URL. Empty uses DATABASE_URL for local migrations.
DIRECT_URL=
PORT=4000
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development
HOST=127.0.0.1
TRUST_PROXY=0
LOG_LEVEL=info
# Only Compose uses a persistent file when JWT_SECRET is empty.
JWT_SECRET_FILE=
